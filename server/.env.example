# Copy this file to .env and fill in your keys.
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name. gemini-3.6-flash answers in ~3 s. Avoid "gemini-flash-latest": in Nov 2026 it pointed
# at gemini-3.8-flash, which took 40-90 s per answer. If a model stalls, the server falls back to Lite.
# You can pin a specific one (see https://ai.google.dev/gemini-api/docs/models).
GEMINI_MODEL=gemini-3.6-flash
# Get a Sarvam key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Port the server listens on (the phone connects to http://<laptop-ip>:PORT)
PORT=4000
